# Paymo Backend Environment Configuration
PAYMO_ENV=development
PAYMO_HOST=127.0.0.1
PAYMO_PORT=8000
DATABASE_URL=sqlite:///./paymo.db
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & Credentials
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Sarvam AI Voice Configuration
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v1

# Cashfree Sandbox Credentials
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox
